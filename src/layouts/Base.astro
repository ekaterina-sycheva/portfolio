
---
import '../styles/global.css';
import settings from '../content/pages/site-settings.json';

const { title, description, image, schema } = Astro.props;
const site = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '');
const canonical = site ? new URL(Astro.url.pathname, `${site}/`).href : undefined;
const socialImage = image && site ? new URL(image, `${site}/`).href : undefined;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ekaterina Sycheva',
  jobTitle: 'Graphic Designer',
  knowsAbout: ['Graphic Design', 'Brand Identity', 'Poster Design'],
  sameAs: [
    'https://www.behance.net/ka94gri073f',
    'https://www.linkedin.com/in/ka94gri'
  ]
};

// Настройки оформления из Pages CMS
const theme = {
  '--background-color': settings.backgroundColor,
  '--text-color': settings.textColor,
  '--muted-color': settings.mutedColor,
  '--border-color': settings.borderColor,
  '--grid-gap': `${settings.gridGap}px`,

  // Совместимость с существующими CSS-переменными
  '--bg': settings.backgroundColor,
  '--text': settings.textColor,
  '--muted': settings.mutedColor,
  '--line': settings.borderColor,
  '--gap': `${settings.gridGap}px`
};
---
<!doctype html>
<html lang="en" style={theme}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  {socialImage && <meta property="og:image" content={socialImage} />}
  <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g,'\u003c')} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')} />}
</head>
<body>
  <header class="header">
    <a class="brand" href="/">EKATERINA SYCHEVA<span>GRAPHIC DESIGNER</span></a>
    <nav aria-label="Main navigation">
      <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>WORK</a>
      <a href="/about/">ABOUT</a>
      <a href="/awards-exhibitions/">AWARDS &amp; EXHIBITIONS</a>
      <a href="/press/">PRESS</a>
    </nav>
  </header>
  <main><slot /></main>
  <footer>
    <span>EKATERINA SYCHEVA © {new Date().getFullYear()}</span>
    <span>GRAPHIC DESIGN PORTFOLIO</span>
  </footer>
</body>
</html>
