---
import Base from '../../layouts/Base.astro';
import { projects } from '../../lib/content';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props;
const schema = {'@context':'https://schema.org','@type':'CreativeWork',name:project.title,description:project.description,creator:{'@type':'Person',name:'Ekaterina Sycheva'}, ...(project.cover ? {image:project.cover}: {})};
---
<Base title={`${project.title} | Ekaterina Sycheva`} description={project.seoDescription || project.description} image={project.cover} schema={schema}>
  <article class="project">
    <a href="/" class="back">← All projects</a>
    <div class="eyebrow">{project.discipline}</div>
    <h1>{project.title}</h1>
    <div class="intro">
      <div><p>{project.description}</p>{project.additionalDescription && <p>{project.additionalDescription}</p>}</div>
      <div><div class="meta"><span>Discipline</span><span>{project.discipline}</span></div><div class="meta"><span>Year</span><span>{project.year}</span></div><div class="meta"><span>Designer</span><span>Ekaterina Sycheva</span></div></div>
    </div>
    <div class="gallery">
      {project.gallery?.length ? project.gallery.map(item=><figure><img src={item.image} alt={item.alt} loading="lazy" />{item.caption && <figcaption>{item.caption}</figcaption>}</figure>) : <div class="placeholder">ORIGINAL PROJECT IMAGES TO BE ADDED</div>}
    </div>
    {!project.gallery?.length && <p class="note">Original project artwork has not been uploaded yet.</p>}
  </article>
</Base>
