{press.map(item=><div class="press-item"><span>{item.year || ''}{item.year ? ' · ' : ''}{item.publication}</span><div><a href={item.url} target="_blank" rel="noopener noreferrer"><strong>{item.title} ↗</strong></a><p>{item.description}</p><p><a class="link" href={item.url} target="_blank" rel="noopener noreferrer">Read original publication ↗</a></p></div></div>)}
</section>
</Base>
